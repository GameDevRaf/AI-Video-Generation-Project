# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required server-side secret for encrypting user provider API keys.
# Generate a unique random value of at least 32 characters.
API_KEY_ENCRYPTION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used only by the manual E2E/database workflow.
# TEST_BASE_URL=http://localhost:3000
